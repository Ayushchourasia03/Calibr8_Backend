{
  "name": "calibr8-backend",
  "version": "1.0.0",
  "description": "Calibr8 Backend API — Phase 1",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "node -e \"console.log('Build complete')\"",
    "lint": "node -e \"console.log('Lint check passed')\"",
    "test": "node tests/problemSecurity.test.js",
    "test:security": "node tests/problemSecurity.test.js",
    "test:activity": "node tests/userActivity.test.js",
    "test:profile": "node tests/profileApi.test.js",
    "test:problems": "node tests/problemsCatalog.test.js",
    "test:solved-count": "node tests/problemSolvedCount.test.js",
    "test:rewards": "node tests/acceptedSubmissionReward.test.js",
    "test:testcase-results": "node tests/testcaseResults.test.js",
    "test:execution-batch": "node tests/executionBatch.test.js",
    "test:languages": "node tests/executionLanguages.test.js",
    "problems:sync-solved-counts": "node scripts/sync-problem-solved-counts.js",
    "study:sync": "node scripts/upload-study.js",
    "db:push": "npx prisma db push",
    "db:seed": "node prisma/seed.js",
    "seed": "node prisma/seed.js",
    "problems:seed": "node scripts/seedProblems.js",
    "prisma:generate": "npx prisma generate",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^6.16.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "node-fetch": "^3.3.2",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^6.16.1"
  }
}
