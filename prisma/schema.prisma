generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  passwordHash      String
  name              String
  difficulty        String?
  rating            Int      @default(800)
  score             Int      @default(0) @map("score")
  streak            Int      @default(0)
  strictPercent     Int      @default(0) @map("strictPercent")
  tier              String   @default("Prism I")
  college           String?
  branch            String?
  batch             String?
  state             String?
  country           String?  @default("India")
  onboarded         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  preferredLanguage String   @default("cpp") @map("preferred_language")
  coins             Int      @default(100)
  activeThemeId     String?  @map("activeThemeId")
  active_theme_id   String?
  
  lastStreakDate    DateTime?
  longestStreak     Int      @default(0)

  socialAccounts                       SocialAccount[]
  ownedThemes                          UserTheme[]
  topics                               UserTopic[]
  submissions                          Submission[]
  activeTheme                          Theme? @relation("ActiveTheme", fields: [activeThemeId], references: [id])
  themes_users_active_theme_idTothemes Theme? @relation("users_active_theme_idTothemes", fields: [active_theme_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([college, score])
  @@index([branch, score])
  @@index([batch, score])
  @@index([state, score])
  @@index([country, score])
  @@map("users")
}

model Topic {
  id       String      @id @default(uuid())
  slug     String      @unique
  name     String
  category String      @default("CORE")
  users    UserTopic[]

  @@map("topics")
}

model UserTopic {
  id      String @id @default(uuid())
  userId  String
  topicId String
  level   String @default("easy")
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("user_topics")
}

model SocialAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  username       String?
  name           String?
  email          String?
  avatarUrl      String?
  profileUrl     String?
  bio            String?
  headline       String?
  stats          Json?
  connectedAt    DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, providerUserId])
  @@map("social_accounts")
}

model Theme {
  id                                  String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  slug                                String      @unique
  name                                String
  price                               Int         @default(0)
  previewColor                        String?
  cssVars                             Json?
  isDefault                           Boolean     @default(false)
  createdAt                           DateTime    @default(now())
  purchases                           UserTheme[]
  activeForUsers                      User[]      @relation("ActiveTheme")
  users_users_active_theme_idTothemes User[]      @relation("users_active_theme_idTothemes")

  @@map("themes")
}

model UserTheme {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String   @map("userId")
  themeId     String   @map("themeId")
  purchasedAt DateTime @default(now())
  theme       Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, themeId])
  @@index([userId])
  @@map("user_themes")
}

model Problem {
  id            String         @id @default(cuid())
  problemNumber Int            @unique @default(autoincrement()) @map("problemNumber")
  slug          String         @unique
  title         String
  description   String
  difficulty    String         @default("Easy")
  
  solvedCount   Int            @default(0) @map("solvedCount")
  timeLimit     Int            @default(1000) @map("timeLimit")
  memoryLimit   Int            @default(256) @map("memoryLimit")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  dsaTopicId    String?        @map("dsaTopicId")
  tags          String[]       @default([])
  templates     CodeTemplate[]
  dsaTopic      DsaTopic?      @relation(fields: [dsaTopicId], references: [id])
  testcases     Testcase[]
  submissions   Submission[] // ADD THIS
  @@map("problems")
}

model DsaTopic {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  order    Int       @default(0)
  problems Problem[]

  @@map("dsa_topics")
}

model Testcase {
  id            String  @id @default(cuid())
  problemId     String  @map("problemId")
  testIndex     Int     @map("testIndex")
  isVisible     Boolean @default(false) @map("isVisible")
  stdinSmall    String  @map("stdinSmall")
  expectedSmall String  @map("expectedSmall")
  sizeBytes     Int     @default(0) @map("sizeBytes")
  r2Key         String? @map("r2Key")
  problem       Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, testIndex])
  @@map("testcases")
}

model CodeTemplate {
  id        String  @id @default(cuid())
  problemId String  @map("problemId")
  language  String
  code      String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, language])
  @@map("code_templates")
}

model Submission {
  id          String   @id @default(cuid())
  problemId   String   @map("problemId")
  userId      String?  @map("userId")
  language    String
  code        String
  status      String // ACCEPTED, WRONG_ANSWER...
  passedCount Int      @default(0) @map("passedCount")
  totalCount  Int      @default(0) @map("totalCount")
  time        String?
  memory      Int?
  createdAt   DateTime @default(now())
  // ADD THESE RELATIONS
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  @@index([problemId, status])
  @@index([userId, status])
  @@map("submissions")
}

model StudySubject {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  description String?
  icon        String?
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  chapters    StudyChapter[]
}

model StudyChapter {
  id        String       @id @default(cuid())
  slug      String
  name      String
  subjectId String
  order     Int
  subject   StudySubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics    StudyTopic[]

  @@unique([subjectId, slug])
}

model StudyTopic {
  id          String       @id @default(cuid())
  slug        String
  name        String
  chapterId   String
  order       Int
  content     String
  isPublished Boolean      @default(true)
  createdAt   DateTime     @default(now())
  mcqs        StudyMCQ[]
  chapter     StudyChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, slug])
}

model StudyMCQ {
  id           String     @id @default(cuid())
  topicId      String
  question     String
  options      Json
  correctIndex Int
  explanation  String?
  difficulty   String     @default("Easy")
  order        Int
  topic        StudyTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
}
