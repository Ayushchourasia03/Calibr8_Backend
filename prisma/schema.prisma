generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String          @id @default(uuid())
  email             String          @unique
  passwordHash      String
  name              String
  difficulty        String?
  rating            Int             @default(800)
  onboarded         Boolean         @default(false)
  preferredLanguage String          @default("cpp") @map("preferred_language")
  role              String          @default("user")
  topics            UserTopic[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  socialAccounts    SocialAccount[]

  coins             Int             @default(100) // starting coins
  activeThemeId     String?         @map("activeThemeId")
  activeTheme       Theme?      @relation("ActiveTheme", fields: [activeThemeId], references: [id])
  ownedThemes       UserTheme[]

  @@map("users")
}

model Topic {
  id       String      @id @default(uuid())
  slug     String      @unique
  name     String
  category String      @default("CORE")
  users    UserTopic[]

  @@map("topics")
}

model UserTopic {
  id      String @id @default(uuid())
  userId  String
  topicId String
  level   String @default("easy")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("user_topics")
}

model SocialAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  username       String?
  name           String?
  email          String?
  avatarUrl      String?
  profileUrl     String?
  bio            String?  @db.Text
  headline       String?
  stats          Json?
  connectedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, providerUserId])
  @@map("social_accounts")
}

model Theme {
  id           String      @id @default(cuid())
  slug         String      @unique
  name         String
  price        Int         @default(0)
  previewColor String?
  cssVars      Json?
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  purchases    UserTheme[]
  activeForUsers User[]    @relation("ActiveTheme")

  @@map("themes")
}

model UserTheme {
  id          String   @id @default(cuid())
  userId      String   @map("userId")
  themeId     String   @map("themeId")
  purchasedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme       Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([userId, themeId])
  @@map("user_themes")
}


model Problem {
  id            String         @id @default(cuid())
  problemNumber Int            @unique @default(autoincrement()) @map("problemNumber")
  slug          String         @unique
  title         String
  description   String         @db.Text
  difficulty    String         @default("Easy")
  timeLimit     Int            @default(1000) @map("timeLimit")
  memoryLimit   Int            @default(256) @map("memoryLimit")
  dsaTopicId    String?        @map("dsaTopicId")
  dsaTopic      DsaTopic?      @relation(fields: [dsaTopicId], references: [id], onDelete: SetNull)
  tags          String[]       @default([])
  testcases     Testcase[]
  templates     CodeTemplate[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("problems")
}

model DsaTopic {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  order     Int       @default(0)
  problems  Problem[]

  @@map("dsa_topics")
}

model Testcase {
  id            String  @id @default(cuid())
  problemId     String  @map("problemId")
  testIndex     Int     @map("testIndex")
  isVisible     Boolean @default(false) @map("isVisible")
  stdinSmall    String  @map("stdinSmall") @db.Text
  expectedSmall String  @map("expectedSmall") @db.Text
  sizeBytes     Int     @default(0) @map("sizeBytes")
  r2Key         String? @map("r2Key")
  problem       Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, testIndex])
  @@map("testcases")
}

model CodeTemplate {
  id        String  @id @default(cuid())
  problemId String  @map("problemId")
  language  String
  code      String  @db.Text
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, language])
  @@map("code_templates")
}

model Submission {
  id                String   @id @default(cuid())
  problemId         String   @map("problemId")
  userId            String?  @map("userId")
  language          String
  code              String   @db.Text
  status            String   // queued, running, done, error
  verdict           String?  // Accepted, Wrong Answer, Time Limit Exceeded, Runtime Error
  passedCount       Int      @default(0) @map("passedCount")
  totalCount        Int      @default(0) @map("totalCount")
  currentTier       Int      @default(1) @map("currentTier")
  tierReached       Int      @default(0) @map("tierReached")
  tiersPassed       Int      @default(0) @map("tiersPassed")
  scoreUnitsAwarded Int      @default(0) @map("scoreUnitsAwarded")
  maxTimeMs         Int?     @map("maxTimeMs")
  maxMemoryKb       Int?     @map("maxMemoryKb")
  compileOutput     String?  @map("compileOutput") @db.Text
  firstFailure      Json?    @map("firstFailure")
  time              String?
  memory            Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@map("submissions")
}

model RevokedToken {
  id        String   @id @default(cuid())
  jti       String   @unique
  token     String?  @db.Text
  userId    String?  @map("userId")
  expiresAt DateTime @map("expiresAt")
  createdAt DateTime @default(now())

  @@map("revoked_tokens")
}

model StudySubject {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  description String?
  icon        String?
  order       Int            @default(0)
  chapters    StudyChapter[]
  createdAt   DateTime       @default(now())
}

model StudyChapter {
  id          String       @id @default(cuid())
  slug        String
  name        String
  subjectId   String
  subject     StudySubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  order       Int
  topics      StudyTopic[]

  @@unique([subjectId, slug])
}

model StudyTopic {
  id          String       @id @default(cuid())
  slug        String
  name        String
  chapterId   String
  chapter     StudyChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  order       Int
  content     String       @db.Text
  isPublished Boolean      @default(true)
  mcqs        StudyMCQ[]
  createdAt   DateTime     @default(now())

  @@unique([chapterId, slug])
}

model StudyMCQ {
  id           String     @id @default(cuid())
  topicId      String
  topic        StudyTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  question     String     @db.Text
  options      Json
  correctIndex Int
  explanation  String?    @db.Text
  difficulty   String     @default("Easy")
  order        Int
}