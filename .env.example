BACKEND_URL=
CODEBOX_TOKEN=
CODEBOX_URL=
CODEBOX_BATCH_EXECUTION_ENABLED=false
# C/C++ judging: compile once and run every testcase in ONE sandbox (multi-case
# harness). Falls back to the batch API / per-testcase path on infrastructure
# errors only. Set to false to disable.
CODEBOX_MULTICASE_ENABLED=true
# Max testcases per harness submission (default 500)
CODEBOX_MULTICASE_MAX_CASES=
DATABASE_URL=
FRONTEND_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
JWT_EXPIRES_IN=
JWT_SECRET=
OAUTH_STATE_SECRET=
R2_ACCESS_KEY_ID=
R2_ACCOUNT_ID=
R2_SECRET_ACCESS_KEY=
# Reverse-proxy hops to trust for client IPs (default: 1 in production, off otherwise)
TRUST_PROXY=
# In-memory cache TTLs in ms (0 disables)
PROBLEM_CACHE_TTL_MS=60000
CATALOG_CACHE_TTL_MS=30000
# Empirical complexity profiling of ACCEPTED submissions (background job).
# Independent of CODEBOX_* flags; disabling it never affects verdicts.
COMPLEXITY_PROFILING_ENABLED=false
COMPLEXITY_PROFILING_CONCURRENCY=1
# Largest profiling input size (sizes double from 250): 16000 = 7 sizes, 64x
# range, ~85 KB CodeBox request (CodeBox keeps payloads in a 256 MB Redis).
COMPLEXITY_PROFILING_MAX_INPUT_SIZE=16000
COMPLEXITY_PROFILING_REPETITIONS=3
COMPLEXITY_PROFILING_TIMEOUT_MS=90000
# Bounded backlog (PENDING+RUNNING); beyond it new profiles are marked FAILED
COMPLEXITY_PROFILING_MAX_PENDING=50
COMPLEXITY_PROFILING_MAX_ATTEMPTS=3

# Judge scheduler (per instance). A slot is one CodeBox request (a chunk of
# testcases); waiting requests are served lightest user first (round 2).
JUDGE_MAX_CONCURRENT=4
JUDGE_MAX_QUEUE=40
# Longest wait for a Run/Submit's first slot (then 503 JUDGE_BUSY), and for later slots
JUDGE_QUEUE_TIMEOUT_MS=30000
JUDGE_CONTINUATION_TIMEOUT_MS=300000
# Static complexity analyzer worker pool (hard per-job timeout)
COMPLEXITY_WORKERS=1
COMPLEXITY_TIMEOUT_MS=2000
COMPLEXITY_MAX_QUEUE=50
# Byte budgets of in-memory caches
PROBLEM_CACHE_MAX_BYTES=67108864
SUBMISSION_CACHE_MAX_BYTES=33554432
CATALOG_STATS_CACHE_TTL_MS=300000
# API explorer: "true" also serves it in production, "false" never serves it,
# empty = development/test only
SERVE_API_CONSOLE=

# --- Runtime / deployment ---
# development | test | production. The API console and localhost CORS origins
# are enabled only for development and test.
NODE_ENV=development
# HTTP port (hosting platforms inject PORT; APP_PORT is accepted as a fallback)
PORT=3000
# Set to false on every replica except one when running several instances
# (daily-problem assignment and streak-decay cron jobs).
ENABLE_CRON_JOBS=true
# Allow a plain http:// CODEBOX_URL. Honoured only for loopback hosts
# (127.0.0.1, localhost, ::1) and, outside production, private addresses or
# Docker service names. Plain HTTP to a public host is always refused.
CODEBOX_ALLOW_INSECURE_HTTP=false
# Absolute session lifetime in days across token refreshes (default 30)
SESSION_MAX_AGE_DAYS=30
# Access-token lifetime. Startup refuses more than 7d in production.
# JWT_EXPIRES_IN=1d

# --- Security limits (src/config/limits.js; validated at startup, an invalid
# value is fatal in production). Defaults shown. ---
# Judge: one user's concurrent CodeBox requests, queued first requests,
# concurrent Run/Submit sessions, and the cross-instance cap on PROCESSING
# submissions (database count)
JUDGE_MAX_ACTIVE_PER_USER=2
JUDGE_MAX_QUEUED_PER_USER=2
JUDGE_MAX_SESSIONS_PER_USER=2
JUDGE_MAX_PROCESSING_PER_USER=2
# Recent-usage half-life used to order waiting users
JUDGE_COST_HALF_LIFE_MS=600000
# Sandbox time (ms) per user per window on this instance; new accounts get less
# and their usage weighs more when ordering (CodeBox: TENANT_BUDGET_MS, all instances)
JUDGE_USER_BUDGET_MS=900000
JUDGE_USER_BUDGET_WINDOW_MS=3600000
JUDGE_NEW_ACCOUNT_AGE_MS=86400000
JUDGE_NEW_ACCOUNT_BUDGET_MS=300000
JUDGE_NEW_ACCOUNT_COST_WEIGHT=2
# After the first failing testcase of a tier, sandbox time (max of CPU and wall
# per case) still spent judging it. The name says CPU for compatibility.
JUDGE_POST_FAILURE_CPU_BUDGET_MS=10000
# Total sandbox time one Run/Submit may use; beyond it: Time Limit Exceeded
JUDGE_EVALUATION_BUDGET_MS=120000
# Target duration of one CodeBox request (chunks shrink for slow code)
JUDGE_TARGET_CHUNK_MS=8000
# A session's first (cost-unknown) request: CodeBox starts no testcase after this long
JUDGE_BLIND_REQUEST_MAX_MS=2000
# First chunk of a large tier (runs alone, so failures are found cheaply)
JUDGE_FIRST_CHUNK_CASES=2
# Largest problem (cases x time limit, ms) judged as one batch
JUDGE_ONE_SHOT_MAX_COST_MS=30000
# Program output longer than max(this, 2 x expected + 1024) is Output Limit Exceeded
JUDGE_MAX_OUTPUT_CHARS=65536
# Largest CodeBox response accepted (bytes)
CODEBOX_MAX_RESPONSE_BYTES=33554432
# Password hashing worker threads, waiting jobs, per-job timeout
PASSWORD_HASH_WORKERS=2
PASSWORD_HASH_MAX_QUEUE=64
PASSWORD_HASH_TIMEOUT_MS=10000
# Per-IP ceilings (IPv6: per /64). Many users can share one IP (campus NAT).
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=1200
# Requests with a validly signed session token: per user, plus a per-IP safety ceiling
API_USER_RATE_LIMIT_MAX=900
API_AUTHENTICATED_IP_RATE_LIMIT_MAX=30000
# Submission-status polling per user per minute
POLL_RATE_LIMIT_MAX=240
# Readiness probe: result reuse (ms) and requests per IP per minute
READINESS_CACHE_MS=5000
HEALTH_RATE_LIMIT_MAX=120
# Request log lines per minute per status class (rest summarized once a minute)
LOG_HTTP_4XX_MAX_PER_MINUTE=120
LOG_HTTP_5XX_MAX_PER_MINUTE=600
# Leaderboard regional fields shown for other users: all | none | comma list
LEADERBOARD_REGIONAL_FIELDS=all
REGISTER_RATE_LIMIT_MAX=30
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
OAUTH_CALLBACK_RATE_LIMIT_MAX=20
# Time allowed to receive a whole request
REQUEST_TIMEOUT_MS=120000
# Heap cap of each static-analyzer worker thread (MB)
COMPLEXITY_WORKER_MAX_HEAP_MB=256
# Security event log lines per event type per minute
SECURITY_LOG_MAX_PER_MINUTE=60
