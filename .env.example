BACKEND_URL=
CODEBOX_TOKEN=
CODEBOX_URL=
CODEBOX_BATCH_EXECUTION_ENABLED=false
# C/C++ judging: compile once and run every testcase in ONE sandbox (multi-case
# harness). Falls back to the batch API / per-testcase path on infrastructure
# errors only. Set to false to disable.
CODEBOX_MULTICASE_ENABLED=true
# Max testcases per harness submission (default 500)
CODEBOX_MULTICASE_MAX_CASES=
DATABASE_URL=
FRONTEND_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
JWT_EXPIRES_IN=
JWT_SECRET=
OAUTH_STATE_SECRET=
R2_ACCESS_KEY_ID=
R2_ACCOUNT_ID=
R2_SECRET_ACCESS_KEY=
# Reverse-proxy hops to trust for client IPs (default: 1 in production, off otherwise)
TRUST_PROXY=
# In-memory cache TTLs in ms (0 disables)
PROBLEM_CACHE_TTL_MS=60000
CATALOG_CACHE_TTL_MS=30000
# Empirical complexity profiling of ACCEPTED submissions (background job).
# Independent of CODEBOX_* flags; disabling it never affects verdicts.
COMPLEXITY_PROFILING_ENABLED=false
COMPLEXITY_PROFILING_CONCURRENCY=1
# Largest profiling input size (sizes double from 250): 16000 = 7 sizes, 64x
# range, ~85 KB CodeBox request (CodeBox keeps payloads in a 256 MB Redis).
COMPLEXITY_PROFILING_MAX_INPUT_SIZE=16000
COMPLEXITY_PROFILING_REPETITIONS=3
COMPLEXITY_PROFILING_TIMEOUT_MS=90000
# Bounded backlog (PENDING+RUNNING); beyond it new profiles are marked FAILED
COMPLEXITY_PROFILING_MAX_PENDING=50
COMPLEXITY_PROFILING_MAX_ATTEMPTS=3

# Backend-wide judge admission control (per instance)
JUDGE_MAX_CONCURRENT=4
JUDGE_MAX_QUEUE=20
JUDGE_QUEUE_TIMEOUT_MS=30000
# Static complexity analyzer worker pool (hard per-job timeout)
COMPLEXITY_WORKERS=1
COMPLEXITY_TIMEOUT_MS=2000
COMPLEXITY_MAX_QUEUE=50
# Byte budgets of in-memory caches
PROBLEM_CACHE_MAX_BYTES=67108864
SUBMISSION_CACHE_MAX_BYTES=33554432
CATALOG_STATS_CACHE_TTL_MS=300000
# Serve the public/ API explorer in production (off by default)
SERVE_API_CONSOLE=false

# Tests: DB-backed tests only run against TEST_DATABASE_URL (never the DATABASE_URL above)
# TEST_DATABASE_URL=
# TEST_CODEBOX_URL=
# TEST_CODEBOX_TOKEN=
