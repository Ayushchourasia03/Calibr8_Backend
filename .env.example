# Must match the authentication token configured on the Codebox runner.
CODEBOX_TOKEN=
JWT_SECRET=
JWT_EXPIRES_IN=7d
OAUTH_STATE_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=